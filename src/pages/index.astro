---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PublicationItem from '../components/PublicationItem.astro';
import Riso from '../components/Riso.astro';
import publications from '../data/publications.json';

// Filter featured and sort by year (newest first)
const featuredPublications = publications
  .filter((pub: any) => pub.featured)
  .sort((a: any, b: any) => b.year - a.year);
const hasEqual = featuredPublications.some((p: any) => p.authors.some((a: string) => a.endsWith('*')));

const elsewhere = [
  { label: 'Email', href: 'mailto:hrdk.bhatnagar@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/hrdkbhatnagar' },
  { label: 'Scholar', href: 'https://scholar.google.com/citations?user=8yj0bswAAAAJ' },
  { label: 'Twitter', href: 'https://x.com/hrdkbhatnagar' },
];
---

<Layout title="Hardik Bhatnagar">
  <Header />
  <main>
    <section class="about-section">
      <div class="about-content">
        <div class="bio rise" style="--i: 1">
          <p>
            I’m a PhD at the Tübingen AI Center, advised by <a href="https://scholar.google.de/citations?user=0z0fNxUAAAAJ&hl=en" target="_blank" rel="noopener">Matthias Bethge</a> and <a href="https://www.andriushchenko.me/" target="_blank" rel="noopener">Maksym Andriushchenko</a>. I work on understanding LLM capabilities and failure modes, with a focus on long horizon evaluation and safety.
          </p>
          <p>
            My research asks how we can rigorously measure what LLMs can and can’t do, especially in extended autonomous settings. I am working on <a href="https://posttrainbench.com" target="_blank" rel="noopener">PostTrainBench</a>, a benchmark measuring whether CLI agents can autonomously post-train LLMs. Most recently, at <a href="https://www.matsprogram.org/" target="_blank" rel="noopener">MATS</a> with Mary Phuong (Google DeepMind), I trained model organisms for sandbagging: models that deliberately underperform on evaluations. Before that, at <a href="https://www.arena.education/" target="_blank" rel="noopener">ARENA 6.0</a> I built a long horizon agent benchmark.
          </p>
          <p>
            I also worked on mechanistic interpretability. At <a href="https://www.lasrlabs.org/" target="_blank" rel="noopener">LASR Labs</a> with <a href="https://x.com/jbloomaus" target="_blank" rel="noopener">Joseph Bloom</a> (UK AISI), we discovered “feature absorption”—a systematic failure mode in Sparse Autoencoders. At Microsoft Research with <a href="https://scholar.google.com/citations?hl=en&user=w8WJCnkAAAAJ&view_op=list_works&sortby=pubdate" target="_blank" rel="noopener">Navin Goyal</a>, I studied how harmful concepts transform during post-training.
          </p>
          <p>
            A long time ago, I worked in computational neuroscience at the Max Planck Institute for Biological Cybernetics and EPFL, modeling how visual features map onto neural activity. I hold a dual degree in Computer Science and Biological Sciences from BITS Pilani.
          </p>
        </div>
        <nav class="elsewhere rise" style="--i: 3" aria-label="Elsewhere">
          {elsewhere.map((link, i) => (
            <>
              {i > 0 && <span class="elsewhere-sep" aria-hidden="true">·</span>}
              <a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">{link.label}</a>
            </>
          ))}
        </nav>
      </div>
      <figure class="portrait rise" style="--i: 2">
        <img src="/images/profile.jpg" alt="Hardik Bhatnagar" />
      </figure>
    </section>

    <div class="section-break rise" style="--i: 4" aria-hidden="true">
      <div class="neuron-rule neuron-rule--long">
        <Riso name="neuron-rule" />
      </div>
      <div class="neuron-rule neuron-rule--short">
        <Riso name="neuron-rule-short" />
      </div>
    </div>

    <section class="rise" style="--i: 5">
      <div class="section-header">
        <div>
          <h2 class="section-title">Selected publications</h2>
          {hasEqual && <p class="equal-note"><span>*</span> Equal contribution</p>}
        </div>
        {/* Every paper is listed here for now; bring back the link once /publications has more
        <a href="/publications" class="section-link">
          All publications
          <Riso name="arrow" class="section-link-arrow" />
        </a>
        */}
      </div>
      {featuredPublications.length > 0 ? (
        <div class="publications-list">
          {featuredPublications.map((pub) => (
            <PublicationItem
              title={pub.title}
              authors={pub.authors}
              venue={pub.venue}
              year={pub.year}
              thumbnail={pub.thumbnail}
              figure={pub.figure}
              award={pub.award}
              links={pub.links}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No publications yet.</p>
      )}
    </section>
  </main>
</Layout>
