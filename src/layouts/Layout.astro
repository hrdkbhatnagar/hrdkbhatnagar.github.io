---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Hardik Bhatnagar - PhD researcher at the Tübingen AI Center working on LLM evaluation and safety" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..600,0..100,0..1;1,9..144,300..600,0..100,0..1&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap" />
    <link rel="stylesheet" href="/styles/global.css" />
    <script is:inline>
      // Theme initialization - runs before page renders to prevent flash
      // Default to light mode unless user has explicitly chosen dark
      (function() {
        const root = document.documentElement;
        const theme = localStorage.getItem('theme') || 'light';
        root.setAttribute('data-theme', theme);
        // Play the entrance (text settling, pen marks drawing) once per visit;
        // later pages in the same visit appear instantly.
        try {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!reduce && !sessionStorage.getItem('intro-seen')) {
            root.classList.add('intro');
            sessionStorage.setItem('intro-seen', '1');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="container">
      <slot />
    </div>
    <script>
      // During the entrance, only what is on screen settles in; marks below the
      // fold draw when scrolled into view
      if (document.documentElement.classList.contains('intro')) {
        document.querySelectorAll('.rise').forEach((el) => {
          if (el.getBoundingClientRect().top > innerHeight) el.style.animation = 'none';
        });
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.6 });
        document.querySelectorAll('.on-view').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
