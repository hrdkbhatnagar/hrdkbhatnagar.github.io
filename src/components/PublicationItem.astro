---
import Riso from './Riso.astro';

interface Props {
  title: string;
  authors: string[];
  venue: string | string[];
  year: number;
  month?: string;
  thumbnail?: string;
  figure?: string;
  award?: string;
  links?: {
    paper?: string;
    code?: string;
    blog?: string;
    website?: string;
  };
}

const { title, authors, venue, year, month, thumbnail, figure, award, links } = Astro.props;

// "NeurIPS 2025 (Oral)" -> "NeurIPS 2025", with "Oral" as a note on its own line
const venues = (Array.isArray(venue) ? venue : [venue]).map((v) => {
  const m = v.match(/^(.*?)\s*\((.*)\)$/);
  return m ? { name: m[1], note: m[2] } : { name: v, note: undefined };
});

// "Best Paper · ICLR 2026 RSI Workshop" -> name in red, where it was given in ink
const [awardName, ...awardDetail] = award ? award.split(' · ') : [];

// Highlight "Hardik Bhatnagar" in authors
const highlightedAuthors = authors.map(author => {
  if (author.toLowerCase().includes('hardik') || author.toLowerCase().includes('bhatnagar')) {
    return `<span class="highlight">${author}</span>`;
  }
  return author;
}).join(', ');

// Link title to website if available, otherwise paper
const titleLink = links?.website || links?.paper;

// Build array of link items for proper separator handling
const linkItems: { label: string; url: string }[] = [];
if (links?.paper) linkItems.push({ label: 'Paper', url: links.paper });
if (links?.code) linkItems.push({ label: 'Code', url: links.code });
if (links?.blog) linkItems.push({ label: 'Blog', url: links.blog });
if (links?.website) linkItems.push({ label: 'Website', url: links.website });
---

<article class="publication-item">
  <Riso name="rule" class="publication-rule" />
  <div class="publication-aside">
    {figure ? (
      <div class="publication-thumbnail publication-thumbnail--figure">
        <Riso name={figure as any} alt={`Key figure from ${title}, redrawn`} />
      </div>
    ) : thumbnail ? (
      <div class="publication-thumbnail">
        <img src={thumbnail} alt={`Thumbnail for ${title}`} loading="lazy" />
      </div>
    ) : (
      <div class="publication-thumbnail publication-thumbnail--empty" aria-hidden="true">
        <span>{year}</span>
      </div>
    )}
    {venues.map((v) => (
      <p class="publication-venue">{v.name}{v.note && <span class="publication-venue-note">{v.note}</span>}</p>
    ))}
  </div>
  <div class="publication-content">
    <h3>
      {titleLink ? (
        <a href={titleLink} target="_blank" rel="noopener">{title}</a>
      ) : (
        title
      )}
    </h3>
    <p class="publication-authors" set:html={highlightedAuthors} />
    <div class="publication-meta">
      {linkItems.length > 0 && (
        <span class="publication-links">
          {linkItems.map((item) => (
            <a href={item.url} class={`publication-link publication-link--${item.label.toLowerCase()}`} target="_blank" rel="noopener">{item.label}</a>
          ))}
        </span>
      )}
    </div>
    {award && (
      <p class="publication-award">
        <span class="award-name">{awardName}</span>
        {awardDetail.length > 0 && <span class="award-detail">· {awardDetail.join(' · ')}</span>}
      </p>
    )}
  </div>
</article>
