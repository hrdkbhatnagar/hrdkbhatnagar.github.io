---
import Mark from './Mark.astro';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <figure class="tailpiece on-view">
    <Mark name="neuron" class="tailpiece-drawing" />
    <figcaption>A pyramidal neuron, after Santiago Ramón y Cajal</figcaption>
  </figure>
  <p class="colophon">
    &copy; {currentYear} Hardik Bhatnagar <span class="sep">·</span> Set in Fraunces &amp; Newsreader
  </p>
</footer>

<style>
  .footer {
    margin-top: 7rem;
    padding-bottom: 4rem;
    text-align: center;
  }

  .tailpiece {
    margin: 0 auto 2.75rem;
  }

  .tailpiece :global(.tailpiece-drawing) {
    display: block;
    width: 150px;
    margin: 0 auto;
    color: var(--ink);
    opacity: 0.88;
  }

  .tailpiece figcaption {
    margin-top: 0.9rem;
    font-style: italic;
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--ink-faded);
  }

  /* First visit only: the drawing is uncovered from the top as it scrolls in */
  :global(.intro) .tailpiece :global(.tailpiece-drawing) {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1100ms var(--ease-in-out);
  }

  :global(.intro) .tailpiece figcaption {
    opacity: 0;
    transition: opacity 400ms ease 700ms;
  }

  :global(.intro) .tailpiece:global(.is-visible) :global(.tailpiece-drawing) {
    clip-path: inset(0 0 0 0);
  }

  :global(.intro) .tailpiece:global(.is-visible) figcaption {
    opacity: 1;
  }

  .colophon {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faded);
  }

  .sep {
    color: var(--rubric);
    margin: 0 0.4em;
  }
</style>
