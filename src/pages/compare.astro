---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const samplePub = {
  title: "A Sober Look at Progress in Language Model Reasoning",
  authors: ["Andreas Hochlehnert*", "Hardik Bhatnagar*", "Vishaal Udandarao"],
  venue: "COLM 2025",
  thumbnail: "/images/publications/sober-reasoning.jpg",
  links: { paper: "#", code: "#", website: "#" }
};

const highlightedAuthors = samplePub.authors.map(author => {
  if (author.toLowerCase().includes('hardik')) {
    return `<span class="highlight">${author}</span>`;
  }
  return author;
}).join(', ');
---

<Layout title="Compare Styles">
  <Header />
  <main>
    <h1 class="page-title">Compare Publication Styles</h1>

    <!-- Option A: More spacing -->
    <h2 class="section-title">Option A: More Spacing</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Venue and links separated by vertical space</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue option-a">{samplePub.venue}</span>
        <div class="publication-links option-a">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option B: Inline venue + links -->
    <h2 class="section-title" style="margin-top: 3rem;">Option B: Inline</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Venue and links on same line with dot separator</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <div class="publication-meta-inline">
          <span class="publication-venue option-b">{samplePub.venue}</span>
          <span class="separator">·</span>
          <a href="#" class="publication-link">Paper</a>
          <span class="separator">·</span>
          <a href="#" class="publication-link">Code</a>
          <span class="separator">·</span>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option C: Muted links -->
    <h2 class="section-title" style="margin-top: 3rem;">Option C: Muted Links</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Links are muted gray, venue stands out in accent</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link muted">Paper</a>
          <a href="#" class="publication-link muted">Code</a>
          <a href="#" class="publication-link muted">Website</a>
        </div>
      </div>
    </article>

    <!-- Option D: Venue after authors -->
    <h2 class="section-title" style="margin-top: 3rem;">Option D: Venue After Authors</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Venue appears at end of author line</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors"><span set:html={highlightedAuthors} /> <span class="author-venue-separator">·</span> <span class="publication-venue-inline">{samplePub.venue}</span></p>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option E: Icon-only links -->
    <h2 class="section-title" style="margin-top: 3rem;">Option E: Icon-Only Links</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Links as small icons, venue is the only text below authors</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <div class="publication-meta-row">
          <span class="publication-venue">{samplePub.venue}</span>
          <div class="publication-icons">
            <a href="#" class="publication-icon" title="Paper">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
            </a>
            <a href="#" class="publication-icon" title="Code">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
            </a>
            <a href="#" class="publication-icon" title="Website">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- Option F: Dashed underline -->
    <h2 class="section-title" style="margin-top: 3rem;">Option F: Dashed Underline</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Venue has subtle dashed underline echoing site borders</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue dashed-underline">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option G: Outlined badge -->
    <h2 class="section-title" style="margin-top: 3rem;">Option G: Outlined Badge</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Thin border, no fill</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue badge-outlined">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option H: Ghost badge -->
    <h2 class="section-title" style="margin-top: 3rem;">Option H: Ghost Badge</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Very subtle background tint</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue badge-ghost">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option I: Muted pill -->
    <h2 class="section-title" style="margin-top: 3rem;">Option I: Muted Pill</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Gray background, muted text</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue badge-muted">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <!-- Option J: Dashed border badge -->
    <h2 class="section-title" style="margin-top: 3rem;">Option J: Dashed Border Badge</h2>
    <p class="text-muted" style="margin-bottom: 1.5rem;">Dashed border echoing site style</p>
    <article class="publication-item">
      <img src={samplePub.thumbnail} class="publication-thumbnail" />
      <div class="publication-content">
        <h3><a href="#">{samplePub.title}</a></h3>
        <p class="publication-authors" set:html={highlightedAuthors} />
        <span class="publication-venue badge-dashed">{samplePub.venue}</span>
        <div class="publication-links">
          <a href="#" class="publication-link">Paper</a>
          <a href="#" class="publication-link">Code</a>
          <a href="#" class="publication-link">Website</a>
        </div>
      </div>
    </article>

    <div class="footer-spacer"></div>
  </main>
</Layout>

<style>
  /* Option A: More spacing */
  .publication-venue.option-a {
    margin-bottom: var(--space-md);
    display: block;
  }
  .publication-links.option-a {
    margin-top: var(--space-sm);
  }

  /* Option B: Inline */
  .publication-meta-inline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-sm);
    flex-wrap: wrap;
  }
  .publication-venue.option-b {
    margin-top: 0;
  }
  .separator {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  /* Option C: Muted links */
  .publication-link.muted {
    color: var(--text-muted);
  }
  .publication-link.muted:hover {
    color: var(--accent);
  }

  /* Option D: Venue after authors */
  .author-venue-separator {
    color: var(--text-muted);
    margin: 0 0.25rem;
  }
  .publication-venue-inline {
    font-family: var(--font-sans);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--accent);
  }

  /* Option E: Icon-only links */
  .publication-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-sm);
  }
  .publication-icons {
    display: flex;
    gap: 0.75rem;
  }
  .publication-icon {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  .publication-icon:hover {
    color: var(--accent);
  }

  /* Option F: Dashed underline */
  .publication-venue.dashed-underline {
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  /* Option G: Outlined badge */
  .publication-venue.badge-outlined {
    padding: 3px 10px;
    border: 1px solid var(--accent);
    border-radius: 3px;
  }

  /* Option H: Ghost badge */
  .publication-venue.badge-ghost {
    padding: 3px 10px;
    background: rgba(191, 138, 84, 0.1);
    border-radius: 3px;
  }

  /* Option I: Muted pill */
  .publication-venue.badge-muted {
    padding: 3px 10px;
    background: var(--bg-alt);
    color: var(--text-muted);
    border-radius: 20px;
  }

  /* Option J: Dashed border badge */
  .publication-venue.badge-dashed {
    padding: 3px 10px;
    border: 1px dashed var(--accent);
    border-radius: 3px;
  }
</style>
