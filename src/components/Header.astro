---
import ThemeToggle from './ThemeToggle.astro';
import Riso from './Riso.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'About' },
  { href: '/publications', label: 'Publications' },
];
---

<header class="header rise" style="--i: 0">
  <a href="/" class="logo">
    Hardik Bhatnagar
    <span class="logo-underline ink-up" aria-hidden="true">
      <Riso name="underline-t1" class="ink-tone ink-tone1" />
      <Riso name="underline-t2" class="ink-tone ink-tone2" />
      <Riso name="underline-t3" class="ink-tone ink-tone3" />
      <Riso name="underline" class="ink-solid" />
    </span>
  </a>

  <nav class="nav">
    {navLinks.map(link => (
      <a
        href={link.href}
        class:list={['nav-link', { active: pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href)) }]}
      >
        {link.label}
      </a>
    ))}
    <ThemeToggle />
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding: 3.5rem 0 0;
    margin-bottom: 4.5rem;
  }

  .logo {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5vw, 2.6rem);
    font-weight: 380;
    font-variation-settings: "opsz" 144, "SOFT" 100, "WONK" 1;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--ink);
  }

  /* the stroke runs under "Hardik": 132 of the name's 41.6 px, so it scales with it */
  .logo :global(.logo-underline) {
    position: absolute;
    left: -0.06em;
    bottom: -0.62em;
    width: 3.17em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .nav-link {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faded);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav-link.active {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
    }
  }

  .nav-link.active {
    text-decoration: underline;
    text-decoration-color: var(--rubric);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.45em;
  }

  @media (max-width: 600px) {
    .header {
      flex-direction: column;
      align-items: center;
      padding-top: 2.5rem;
      margin-bottom: 3rem;
      gap: 1.6rem;
    }

    .nav {
      gap: 1.4rem;
    }
  }
</style>
